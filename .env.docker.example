POSTGRES_DB=bgsale_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@bgsales.com
PGADMIN_DEFAULT_PASSWORD=REPLACE-WITH-A-STRONG-PASSWORD-EXAMPLE
PGADMIN_PORT=5050

APP_DEBUG=true
JWT_SECRET=REPLACE-WITH-RANDOM-SECRET-EXAMPLE-run-openssl-rand-base64-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_SESSION_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=true
AUTO_CREATE_TABLES=true
ENFORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1,bgsale-core

CORE_PORT=8000
FRONTEND_PORT=3002

# For a browser on your machine, the frontend should call the published host port.
VITE_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
INVENTORY_ALERT_EMAIL=
