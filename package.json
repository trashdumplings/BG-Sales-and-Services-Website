{
  "name": "bgsale_website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "powershell -ExecutionPolicy Bypass -File .\\server\\start.ps1",
    "dev:all": "concurrently -n server,client -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "npm run build && vite-bundle-visualizer",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives",
    "test": "node --test tests/frontend/*.test.mjs"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@vercel/speed-insights": "^1.0.10",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.3",
    "motion": "^12.42.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.2",
    "react-scroll": "^1.9.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "path": "^0.12.7",
    "rollup-plugin-visualizer": "^5.12.0",
    "terser": "^5.27.0",
    "vite": "^5.1.4",
    "web-vitals": "^3.5.0"
  }
}
