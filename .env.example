# Application Environment Variables
# Copy this file to .env.local and update values

# API Configuration
VITE_API_BASE_URL=https://api.web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Google Maps & Services
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
VITE_GOOGLE_ANALYTICS_ID=your_analytics_id_here

# Application Settings
VITE_APP_NAME=BG Sales & Supplies
VITE_APP_DOMAIN=https://bgsalesandsupplies.com
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=true

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_RATE_LIMITING=true

# Cache Strategy
VITE_CACHE_VERSION=1
VITE_CACHE_MAX_AGE=86400
