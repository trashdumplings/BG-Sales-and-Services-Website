POSTGRES_DB=bgsale_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@bgsales.com
PGADMIN_DEFAULT_PASSWORD=replace-with-strong-pgadmin-password
PGADMIN_PORT=5050

APP_DEBUG=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_SESSION_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=false
AUTO_CREATE_TABLES=false
ENFORCE_HTTPS=true
TRUSTED_HOSTS=your-domain.com,www.your-domain.com,api.your-domain.com

CORE_PORT=8000
FRONTEND_PORT=3002

# Used by docker-compose.prod.yml's Caddy service for automatic HTTPS (Let's Encrypt).
# Caddy will terminate TLS for your-domain.com, www.your-domain.com, and api.your-domain.com,
# so DNS A/AAAA records for all three must point at this server before you bring the stack up.
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

VITE_API_BASE=https://api.your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@your-domain.com
INVENTORY_ALERT_EMAIL=
