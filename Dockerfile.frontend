FROM node:22.23.2-alpine3.24 AS build

WORKDIR /app

COPY package.json package-lock.json ./
# Keep production image builds deterministic and avoid registry audit/funding calls
# that can make Docker builds fail even after packages have been downloaded.
# Vite and the React build plugin are devDependencies, so the build stage must
# install them even when Docker/npm is invoked from a production environment.
RUN npm ci --include=dev --no-audit --no-fund \
    && test -x node_modules/.bin/vite

COPY vite.config.js ./vite.config.js
COPY services/frontend ./services/frontend

ARG VITE_API_BASE=http://localhost:8000
ARG VITE_ALLOW_PUBLIC_REGISTRATION=false
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_ALLOW_PUBLIC_REGISTRATION=${VITE_ALLOW_PUBLIC_REGISTRATION}

RUN npm run build

FROM nginx:1.29.8-alpine3.23

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
